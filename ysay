#!/bin/bash

# ysay (2023) - Markierten Text mit Sprachsynthese (piper) per Tastenkombination als Audiostream ausgeben.
# https://github.com/thefoster/ysay-hotkey
# Dies ist das Ergebnis einer Kombination aus dem Script xsay (von Alex https://www.youtube.com/watch?v=UjBtKRd7c34) und dem Vorgehen zur Sprachausgabe mit piper von Thorsten-Voice (https://www.thorsten-voice.de/kostenloses-deutsches-text-to-speech-tts
# Update 2026: Funktionalität auf Wayland erweitert, Bug in $PID behoben, $MODEL und $RATE modularisiert, $PIPER als Variable

# Auf dem Desktop markierten Text in Variable $text setzen
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
if ! command -v wl-paste >/dev/null 2>&1; then
echo "Fehler: wl-paste wurde nicht gefunden. Bitte wl-clipboard installieren." >&2
exit 1
fi
text="$(wl-paste --primary --type text/plain)";
elif [ "$XDG_SESSION_TYPE" = "x11" ]; then
if ! command -v xsel >/dev/null 2>&1; then
echo "Fehler: xsel wurde nicht gefunden." >&2
exit 1
fi
text="$(xsel -o)";
else
echo "Unbekannter Sitzungstyp: $XDG_SESSION_TYPE" >&2
exit 1
fi

if [ -z "$text" ]; then
exit 0
fi

if ! command -v aplay >/dev/null 2>&1; then
echo "Fehler: aplay wurde nicht gefunden. Bitte alsa-utils installieren." >&2
exit 1
fi

PIPER=~/bin/piper/piper
MODEL=~/bin/piper/de_DE-kerstin-low.onnx
RATE=16000
# Auswahlbeispiele deutscher Stimmen
#MODEL=~/bin/piper/de_DE-kerstin-low.onnx
#RATE=16000
#MODEL=~/bin/piper/de_DE-ramona-low.onnx
#RATE=16000
#MODEL=~/bin/piper/de_DE-eva_k-x_low.onnx
#RATE=16000
#MODEL=~/bin/piper/de_DE-thorsten-high.onnx
#RATE=22000

if [ ! -x "$PIPER" ]; then
echo "Fehler: Piper wurde nicht gefunden: $PIPER" >&2
exit 1
fi

if [ ! -f "$MODEL" ]; then
echo "Fehler: Piper-Modell wurde nicht gefunden: $MODEL" >&2
exit 1
fi

# Ein paar von xsay übernommene Ersetzungen
# Doppelpunkt aussprechen
# Doppelslash aussprechen
# Slash aussprechen
# Minus aussprechen
# & Zeichen Aussprechen
# " Zeichen Aussprechen
# # Zeichen Aussprechen
# z.B. Zum Beispiel aussprechen
# etc Zum Beispiel aussprechen
text=`printf '%s' "$text" | sed \
-e "s/:/ Doppelpunkt /g" \
-e 's,//, Doppelslash.,g' \
-e 's,/, Slash ,g' \
-e 's,-, Minus ,g' \
-e 's,&, und ,g' \
-e 's,", Anführungszeichen ,g' \
-e 's,#, Häshtäg ,g' \
-e 's,\<etc\>, etzetera ,g' \
-e 's,\.\z\.B\., zum Beispiel ,g'`;

# ProzessID der Audiowiedergabe ermitteln und in Datei schreiben (für xsaykill)
# echo $PID >/tmp/ysay-avplay.pid
# PID in Ausgabe von Piper verschoben
setsid bash -c 'printf "%s\n" "$1" | "$2" --model "$3" --output-raw | aplay -r "$4" -f S16_LE -t raw' _ "$text" "$PIPER" "$MODEL" "$RATE" & echo $! >/tmp/ysay-avplay.pid
